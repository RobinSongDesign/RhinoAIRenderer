<Project>
  <!-- Shared settings for every project under src/, tests/, tools/ and spikes/. -->
  <PropertyGroup>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <Version>2.0.0</Version>
    <Company>Robin Song Design</Company>
    <Product>Chameleon</Product>
    <Copyright>Copyright (c) Robin Song Design</Copyright>
    <!-- NETSDK1138: net7.0 is out of support but is what Rhino 8 runs on. NU1701: RhinoCommon restore fallback. -->
    <NoWarn>$(NoWarn);NETSDK1138;NU1701</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
