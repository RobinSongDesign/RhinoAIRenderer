  "styleTemplates": [
    {
      "id": "custom",
      "name": {
        "zh": "自定义",
        "en": "Custom"
      },
      "prompt": ""
    },
    {
      "id": "arch-render",
      "name": {
        "zh": "建筑渲染",
        "en": "Architectural Rendering"
      },
      "prompt": "Professional architectural rendering with photorealistic lighting, high dynamic range (HDR), ambient occlusion, soft shadows, depth of field, ultra-detailed textures, 4K resolution, clean white background or neutral gray studio backdrop, architectural photography style with proper perspective and vanishing points"
    },
    {
      "id": "mir",
      "name": {
        "zh": "MIR风格",
        "en": "MIR Style"
      },
      "prompt": "MIR architectural visualization style, cinematic rendering, moody atmosphere with dramatic lighting, high contrast, photorealistic finish, unreal engine 5 quality, architectural magazine editorial style, wide angle lens perspective, hyper-detailed render with lens flare and bloom effects"
    },
    {
      "id": "sketch",
      "name": {
        "zh": "手绘草图",
        "en": "Hand Sketch"
      },
      "prompt": "Architectural sketch rendered in realistic hand-drawn graphite pencil technique on textured paper, architectural line drawing with proper proportions, architectural presentation sketch style, loose gestural strokes, cross-hatching for shading, sketchbook aesthetic, white or cream paper background"
    },
    {
      "id": "cyberpunk",
      "name": {
        "zh": "赛博朋克",
        "en": "Cyberpunk"
      },
      "prompt": "Cyberpunk aesthetic with neon lighting, reflective wet surfaces, holographic billboards, volumetric fog, dramatic low-angle shot, futuristic cityscape at night, cinematic color grading with cyan and magenta accents, Blade Runner inspired atmosphere, high contrast, lens flare, bokeh"
    },
    {
      "id": "minimalist",
      "name": {
        "zh": "极简主义",
        "en": "Minimalist"
      },
      "prompt": "Minimalist architectural photography, clean geometric compositions, abundant negative space, soft natural lighting from large windows, monochrome or neutral color palette, high-key studio lighting, Hasselblad medium format camera quality, architectural digest editorial style, pristine white backgrounds"
    },
    {
      "id": "interior",
      "name": {
        "zh": "室内设计",
        "en": "Interior Design"
      },
      "prompt": "Interior design photography with warm ambient lighting, golden hour natural light streaming through windows, cozy atmosphere, professional interior magazine shoot, depth of field with subject in focus and blurred background, 35mm lens perspective, lifestyle photography style, high-end residential interior, proper white balance"
    },
    {
      "id": "photo",
      "name": {
        "zh": "写实摄影",
        "en": "Realistic Photography"
      },
      "prompt": "Professional architectural photography shot with Canon EOS R5 or Sony A7R V, 24-70mm f/2.8 lens, proper exposure with f/8 for maximum sharpness, perspective correction, architectural tripod setup, neutral density filters for long exposure, hyperfocal distance focusing, commercial real estate photography style"
    },
    {
      "id": "dusk",
      "name": {
        "zh": "黄昏氛围",
        "en": "Dusk Atmosphere"
      },
      "prompt": "Golden hour architectural photography with warm sunset lighting casting long dramatic shadows, sky gradient from orange to purple, silhouette effect, romantic mood, cinematic landscape photography, time-lapse inspired aesthetic, professional architectural twilight shot, warm color temperature around 3200K"
    },
    {
      "id": "watercolor",
      "name": {
        "zh": "水彩画",
        "en": "Watercolor"
      },
      "prompt": "Watercolor painting illustration style, soft bleeding colors, wet-on-wet technique, architectural subject rendered in artistic watercolor, light and airy palette, delicate brush strokes, textured watercolor paper background, architectural illustration in art gallery style"
    },
    {
      "id": "movie-poster",
      "name": {
        "zh": "电影海报",
        "en": "Movie Poster"
      },
      "prompt": "Movie poster style composition, dramatic cinematic lighting, shallow depth of field, subject framed as hero, cinematic color grading with teal and orange tones, film grain texture, anamorphic lens flare, epic wide shot, IMAX aspect ratio, Hollywood movie production quality"
    }
  ]
}
