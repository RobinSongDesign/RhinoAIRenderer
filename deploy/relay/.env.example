# Copy to .env and fill in. Never commit .env.
# Domain pointing at this server (an A record); Caddy gets its certificate automatically.
DOMAIN=api.example.com
# new-api image tag; see docker-compose.yml for the verified version.
NEW_API_VERSION=v1.0.0-rc.51
# Long random strings, e.g. from: openssl rand -hex 24
POSTGRES_PASSWORD=
REDIS_PASSWORD=
SESSION_SECRET=
