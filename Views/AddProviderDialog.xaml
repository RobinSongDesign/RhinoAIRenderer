<Window x:Class="AIRenderer.Views.AddProviderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Custom Provider" Height="450" Width="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
            <Setter Property="Foreground" Value="#333"/>
        </Style>
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Provider Name" Style="{StaticResource Label}"/>
            <TextBox x:Name="NameBox" Style="{StaticResource Input}"
                     ToolTip="e.g. My Proxy"/>

            <TextBlock Text="Base URL" Style="{StaticResource Label}"/>
            <TextBox x:Name="UrlBox" Style="{StaticResource Input}"
                     ToolTip="e.g. https://api.example.com"/>

            <TextBlock Text="API Format" Style="{StaticResource Label}"/>
            <ComboBox x:Name="ApiFormatCombo" Padding="8,6" FontSize="12"
                      BorderBrush="#CCC" BorderThickness="1" Background="White"
                      SelectionChanged="ApiFormatCombo_SelectionChanged">
                <ComboBoxItem Content="Gemini Compatible  (generateContent)" Tag="gemini"/>
                <ComboBoxItem Content="OpenAI Images  (gpt-image-1 / images/edits)" Tag="openai"/>
            </ComboBox>

            <TextBlock Text="Auth Type" Style="{StaticResource Label}"/>
            <ComboBox x:Name="AuthTypeCombo" Padding="8,6" FontSize="12"
                      BorderBrush="#CCC" BorderThickness="1" Background="White">
                <ComboBoxItem Content="Bearer Token  (Authorization: Bearer ...)" Tag="bearer"/>
                <ComboBoxItem Content="Gemini Key  (x-goog-api-key: ...)" Tag="goog"/>
            </ComboBox>

            <TextBlock Text="Models (comma-separated)" Style="{StaticResource Label}"/>
            <TextBox x:Name="ModelsBox" Style="{StaticResource Input}"
                     ToolTip="e.g. gemini-2.0-flash-exp, gemini-1.5-pro"/>

            <TextBlock x:Name="ErrorText" Foreground="#D32F2F" FontSize="11" Margin="0,10,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="Cancel_Click"
                    Padding="20,8" Margin="0,0,10,0"
                    Background="#E0E0E0" Foreground="#333" BorderThickness="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="Add" Click="Add_Click"
                    Padding="20,8"
                    Background="#4A90D9" Foreground="White" BorderThickness="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A7BC8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
