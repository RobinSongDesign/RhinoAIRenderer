# Copy to pay.env next to docker-compose.yml (sudo cp ... && sudo chmod 600 pay.env). Never commit pay.env.
# Epay merchant id and key: enter the same two values in new-api (支付网关 → 易支付商户 ID / 密钥).
# Generate the key with: openssl rand -hex 24
EPAY_PID=1001
EPAY_KEY=
# Where buyers and Alipay reach the bridge (Nginx forwards /pay/ to it).
PUBLIC_URL=https://api.rhchameleon.top/pay
# new-api hosts allowed as notify/return addresses.
ALLOWED_HOSTS=api.rhchameleon.top,api.robinsong.top
# Alipay application (开放平台 → 应用 → AppID) and the Alipay public key shown after setting the key.
ALIPAY_APP_ID=
ALIPAY_PUBLIC_KEY=
ALIPAY_PRIVATE_KEY_FILE=/data/alipay_app_private.pem
# Unpaid orders expire after this many minutes.
ORDER_TIMEOUT_MINUTES=15
# Largest single top-up, in yuan.
MAX_AMOUNT=5000
