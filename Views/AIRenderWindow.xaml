<Window x:Class="AIRenderer.Views.AIRenderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AIRenderer.Views"
        Title="Chameleon AI Renderer" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,5,0,2"/>
            <Setter Property="Foreground" Value="#555"/>
        </Style>

        <!-- Primary button template -->
        <ControlTemplate x:Key="BtnTpl" TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.88"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="#4A90D9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template" Value="{StaticResource BtnTpl}"/>
        </Style>
        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template" Value="{StaticResource BtnTpl}"/>
        </Style>
        <Style x:Key="BtnGreen" TargetType="Button">
            <Setter Property="Background" Value="#43A047"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template" Value="{StaticResource BtnTpl}"/>
        </Style>
        <Style x:Key="BtnPurple" TargetType="Button">
            <Setter Property="Background" Value="#7B5EA7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template" Value="{StaticResource BtnTpl}"/>
        </Style>
        <Style x:Key="BtnLight" TargetType="Button">
            <Setter Property="Background" Value="#6BA5E7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template" Value="{StaticResource BtnTpl}"/>
        </Style>

        <!-- Small icon button for per-item actions in batch list -->
        <Style x:Key="BtnSmall" TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template" Value="{StaticResource BtnTpl}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════════════ MAIN CONTENT ══════════════════════ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT: Image area ──────────────────────────────────── -->
            <Grid Grid.Column="0" Margin="0,0,14,0">

                <!-- SINGLE MODE -->
                <Grid Visibility="{Binding IsSingleMode, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Header="Source Image" Margin="0,0,0,8">
                        <Border Background="#FAFAFA" BorderBrush="#DDD" BorderThickness="1">
                            <Grid>
                                <TextBlock Text="Click 'Capture View' to capture viewport"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="#999" FontSize="14"
                                           Visibility="{Binding HasSourceImage, Converter={StaticResource InvBoolToVis}}"/>
                                <Image Source="{Binding SourceImage}" Stretch="Uniform" Margin="4"
                                       Cursor="Hand"
                                       Tag="{Binding SourceImage}"
                                       MouseLeftButtonUp="AnyImage_PreviewClick"
                                       Visibility="{Binding HasSourceImage, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Border>
                    </GroupBox>

                    <GroupBox Grid.Row="1" Header="Generated Result" Margin="0,8,0,0">
                        <Border Background="#FAFAFA" BorderBrush="#DDD" BorderThickness="1">
                            <Grid>
                                <TextBlock Text="Generated image will appear here"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="#999" FontSize="14"
                                           Visibility="{Binding HasResultImage, Converter={StaticResource InvBoolToVis}}"/>
                                <Image Source="{Binding ResultImage}" Stretch="Uniform" Margin="4"
                                       Cursor="Hand"
                                       Tag="{Binding ResultImage}"
                                       MouseLeftButtonUp="AnyImage_PreviewClick"
                                       Visibility="{Binding HasResultImage, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Border>
                    </GroupBox>
                </Grid>

                <!-- BATCH MODE -->
                <Grid Visibility="{Binding IsBatchMode, Converter={StaticResource BoolToVis}}">
                    <!-- Empty state -->
                    <TextBlock Text="点击右侧「加载命名视图」加载视图列表"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#CCC" FontSize="14"
                               Visibility="{Binding BatchVM.HasBatchItems, Converter={StaticResource InvBoolToVis}}"/>

                    <!-- Items list -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding BatchVM.HasBatchItems, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding BatchVM.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" Background="White"
                                            BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5">
                                        <StackPanel>
                                        <Grid Margin="10,8,10,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="105"/>
                                                <ColumnDefinition Width="175"/>
                                                <ColumnDefinition Width="26"/>
                                                <ColumnDefinition Width="175"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1" Text="{Binding ViewName}"
                                                       FontWeight="SemiBold" FontSize="11"
                                                       TextWrapping="Wrap" VerticalAlignment="Center"
                                                       Margin="6,0"/>

                                            <!-- Source thumbnail -->
                                            <Border Grid.Column="2" Width="175" Height="115"
                                                    Background="#F5F5F5" BorderBrush="#E8E8E8" BorderThickness="1">
                                                <Grid>
                                                    <TextBlock Text="未捕获" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" Foreground="#CCC" FontSize="11"
                                                               Visibility="{Binding HasSourceImage, Converter={StaticResource InvBoolToVis}}"/>
                                                    <Image Source="{Binding SourceImage}" Stretch="Uniform" Margin="2"
                                                           Cursor="Hand"
                                                           Tag="{Binding SourceImage}"
                                                           MouseLeftButtonUp="AnyImage_PreviewClick"
                                                           Visibility="{Binding HasSourceImage, Converter={StaticResource BoolToVis}}"/>
                                                </Grid>
                                            </Border>

                                            <TextBlock Grid.Column="3" Text="→" FontSize="18" Foreground="#CCC"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            <!-- Result thumbnail -->
                                            <Border Grid.Column="4" Width="175" Height="115"
                                                    Background="#F5F5F5" BorderBrush="#E8E8E8" BorderThickness="1">
                                                <Grid>
                                                    <TextBlock Text="{Binding Status}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="#CCC" FontSize="11"
                                                               Visibility="{Binding HasResult, Converter={StaticResource InvBoolToVis}}"/>
                                                    <Image Source="{Binding ResultImage}" Stretch="Uniform" Margin="2"
                                                           Cursor="Hand"
                                                           Tag="{Binding ResultImage}"
                                                           MouseLeftButtonUp="AnyImage_PreviewClick"
                                                           Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}"/>
                                                    <Border Background="#CCFFFFFF" CornerRadius="2"
                                                            Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <ProgressBar IsIndeterminate="True" Width="70" Height="3"/>
                                                            <TextBlock Text="生成中..." HorizontalAlignment="Center"
                                                                       Margin="0,4,0,0" FontSize="10" Foreground="#555"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- Per-item actions -->
                                            <StackPanel Grid.Column="5" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status}" FontSize="10"
                                                           Foreground="#888" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                                <Button Content="刷新" Tag="{Binding}"
                                                        Click="BatchCaptureOne_Click"
                                                        Background="#6AAF6A" Foreground="White"
                                                        Style="{StaticResource BtnSmall}" Margin="0,0,0,4"/>
                                                <Button Content="重新生成" Tag="{Binding}"
                                                        Click="BatchRegenerateOne_Click"
                                                        IsEnabled="{Binding HasSourceImage}"
                                                        Background="#E67E22" Foreground="White"
                                                        Style="{StaticResource BtnSmall}" Margin="0,0,0,4"/>
                                                <Button Content="保存" Tag="{Binding}"
                                                        Click="BatchSaveOne_Click"
                                                        IsEnabled="{Binding HasResult}"
                                                        Background="#4A90D9" Foreground="White"
                                                        Style="{StaticResource BtnSmall}"/>
                                            </StackPanel>
                                        </Grid>
                                        <!-- Per-item addon prompt -->

                                        <Grid Margin="10,0,10,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="+" FontSize="11" Foreground="#AAA"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding AddonPrompt, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="11" Padding="5,3"
                                                     BorderBrush="#E8E8E8" BorderThickness="1"
                                                     Background="#FAFAFA"
                                                     ToolTip="此视图的附加提示词（追加到共用 Prompt 之后）"/>
                                        </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ── RIGHT: Settings panel ──────────────────────────────── -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel>

                    <!-- Mode toggle -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Single" Click="SingleModeBtn_Click"
                                FontSize="12" Padding="0,8" BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#E0E0E0"/>
                                    <Setter Property="Foreground" Value="#555"/>
                                    <Setter Property="Template" Value="{StaticResource BtnTpl}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSingleMode}" Value="True">
                                            <Setter Property="Background" Value="#4A90D9"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Column="2" Content="Batch" Click="BatchModeBtn_Click"
                                FontSize="12" Padding="0,8" BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#E0E0E0"/>
                                    <Setter Property="Foreground" Value="#555"/>
                                    <Setter Property="Template" Value="{StaticResource BtnTpl}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBatchMode}" Value="True">
                                            <Setter Property="Background" Value="#7B5EA7"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Header + gear -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="SETTINGS" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                        <Button Grid.Column="1" x:Name="SettingsButton" Click="SettingsButton_Click"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                ToolTip="API Settings" VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" Padding="4">
                                        <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                                              Fill="#666" Width="20" Height="20" Stretch="Uniform"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- ── SINGLE: Capture ── -->
                    <StackPanel Visibility="{Binding IsSingleMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="1. CAPTURE" Style="{StaticResource SectionHeader}"/>
                        <Button Content="Capture Active View" Command="{Binding CaptureCommand}"
                                Style="{StaticResource BtnPrimary}" Margin="0,0,0,4"/>
                    </StackPanel>

                    <!-- ── BATCH: View controls ── -->
                    <StackPanel Visibility="{Binding IsBatchMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="1. BATCH VIEWS" Style="{StaticResource SectionHeader}"/>
                        <Button Content="加载并捕获命名视图" Command="{Binding BatchVM.LoadAndCaptureCommand}"
                                Style="{StaticResource BtnPrimary}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="全选" Command="{Binding BatchVM.SelectAllCommand}"
                                    Style="{StaticResource BtnSecondary}"/>
                            <Button Grid.Column="2" Content="取消全选" Command="{Binding BatchVM.DeselectAllCommand}"
                                    Style="{StaticResource BtnSecondary}"/>
                        </Grid>
                        <ProgressBar IsIndeterminate="True" Height="2" Margin="0,4,0,2"
                                     Visibility="{Binding BatchVM.IsRunning, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock FontSize="11" Foreground="#555" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Text="{Binding BatchVM.StatusMessage}"/>
                        <TextBlock FontSize="11" Foreground="#4A90D9" Margin="0,1,0,0"
                                   Visibility="{Binding BatchVM.IsRunning, Converter={StaticResource BoolToVis}}">
                            <Run Text="{Binding BatchVM.DoneCount, Mode=OneWay}"/>
                            <Run Text=" / "/>
                            <Run Text="{Binding BatchVM.TotalCount, Mode=OneWay}"/>
                            <Run Text=" 已完成"/>
                        </TextBlock>

                        <!-- Reference image drop zone -->
                        <TextBlock Text="2. STYLE REFERENCE" Style="{StaticResource SectionHeader}"/>
                        <Border x:Name="ReferenceDropZone"
                                Height="90" Background="#F7F7F7"
                                BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4"
                                AllowDrop="True"
                                DragEnter="ReferenceZone_DragEnter"
                                Drop="ReferenceZone_Drop"
                                MouseLeftButtonUp="ReferenceZone_Click"
                                Cursor="Hand">
                            <Grid>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding BatchVM.HasReferenceImage, Converter={StaticResource InvBoolToVis}}">
                                    <TextBlock Text="拖入 / 点击选择参考图" FontSize="11" Foreground="#BBB" HorizontalAlignment="Center"/>
                                    <TextBlock Text="光照、材质、风格等每次请求都会参考此图" FontSize="10" Foreground="#CCC" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Image Source="{Binding BatchVM.ReferenceImage}" Stretch="Uniform" Margin="4"
                                       Visibility="{Binding BatchVM.HasReferenceImage, Converter={StaticResource BoolToVis}}"
                                       Tag="{Binding BatchVM.ReferenceImage}"
                                       MouseLeftButtonUp="AnyImage_PreviewClick"/>
                                <Button Content="×" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,3,3,0" Width="20" Height="20" FontSize="12"
                                        Background="#E05555" Foreground="White" BorderThickness="0"
                                        Cursor="Hand"
                                        Click="ClearReference_Click"
                                        Visibility="{Binding BatchVM.HasReferenceImage, Converter={StaticResource BoolToVis}}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="2">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ── Provider info ── -->
                    <TextBlock Text="2. SERVICE PROVIDER" Style="{StaticResource SectionHeader}"/>
                    <Border Background="#E8F4FD" BorderBrush="#B8D4E8" BorderThickness="1"
                            CornerRadius="4" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock FontSize="12" Foreground="#333">
                                <Run Text="Provider: "/>
                                <Run Text="{Binding Settings.SelectedProviderDisplayName, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                            <TextBlock Text="Click gear icon above to configure API settings"
                                       FontSize="10" Foreground="#888" FontStyle="Italic" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ── Generation Parameters (shared) ── -->
                    <TextBlock Text="3. GENERATION PARAMETERS" Style="{StaticResource SectionHeader}"/>

                    <TextBlock Text="Model" Style="{StaticResource Label}"/>
                    <ComboBox ItemsSource="{Binding Settings.ModelList}"
                              SelectedItem="{Binding Settings.SelectedModelItem}"
                              DisplayMemberPath="DisplayName"
                              Padding="8,6" FontSize="12" Margin="0,0,0,8"/>

                    <TextBlock Text="Style Template" Style="{StaticResource Label}"/>
                    <ComboBox ItemsSource="{Binding Settings.StyleTemplates}"
                              SelectedItem="{Binding Settings.SelectedStyle}"
                              DisplayMemberPath="Name"
                              Padding="8,6" FontSize="12" Margin="0,0,0,8"/>

                    <TextBlock Text="Prompt" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding Settings.Prompt, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" FontSize="12" BorderBrush="#CCC" BorderThickness="1"
                             TextWrapping="Wrap" AcceptsReturn="True" Height="60"
                             VerticalScrollBarVisibility="Auto"/>

                    <TextBox Text="{Binding Settings.SystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="Collapsed"/>

                    <TextBlock Text="Aspect Ratio" Style="{StaticResource Label}"/>
                    <ComboBox ItemsSource="{Binding Settings.AspectRatios}"
                              SelectedItem="{Binding Settings.SelectedAspectRatio}"
                              DisplayMemberPath="Name"
                              Padding="8,6" FontSize="12" Margin="0,0,0,8"/>

                    <TextBlock Text="Image Size" Style="{StaticResource Label}"/>
                    <ComboBox ItemsSource="{Binding Settings.ImageSizes}"
                              SelectedItem="{Binding Settings.SelectedImageSize}"
                              Padding="8,6" FontSize="12" Margin="0,0,0,8"/>

                    <!-- ── Action buttons ── -->

                    <!-- Single: Generate -->
                    <Button Content="Generate Image" Command="{Binding GenerateCommand}"
                            Style="{StaticResource BtnPrimary}" Margin="0,12,0,8"
                            Visibility="{Binding IsSingleMode, Converter={StaticResource BoolToVis}}"/>

                    <!-- Batch: Render + Cancel -->
                    <StackPanel Visibility="{Binding IsBatchMode, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                        <Button Content="开始批量渲染" Command="{Binding BatchVM.RenderSelectedCommand}"
                                Style="{StaticResource BtnPurple}" Margin="0,0,0,6"/>
                        <Button Content="取消渲染" Command="{Binding BatchVM.CancelCommand}"
                                Style="{StaticResource BtnSecondary}" Margin="0,0,0,8"/>
                    </StackPanel>

                    <!-- Single: Save + Use as Source + Clear -->
                    <StackPanel Visibility="{Binding IsSingleMode, Converter={StaticResource BoolToVis}}">
                        <Button Content="Save Result" Command="{Binding SaveResultCommand}"
                                Style="{StaticResource BtnLight}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Use as Source" Command="{Binding UseResultAsSourceCommand}"
                                    Style="{StaticResource BtnSecondary}"/>
                            <Button Grid.Column="2" Content="Clear All" Command="{Binding ClearCommand}"
                                    Style="{StaticResource BtnSecondary}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Batch: Save All -->
                    <Button Content="保存全部结果" Command="{Binding BatchVM.SaveAllCommand}"
                            Style="{StaticResource BtnSecondary}" Margin="0,0,0,8"
                            Visibility="{Binding IsBatchMode, Converter={StaticResource BoolToVis}}"/>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ══════════════════════════ STATUS BAR ════════════════════════ -->
        <Border Grid.Row="1" Background="#EEE" Padding="12,8" Margin="0,10,0,0" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                           Foreground="#555" FontSize="12"
                           Visibility="{Binding IsSingleMode, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding BatchVM.StatusMessage}" VerticalAlignment="Center"
                           Foreground="#555" FontSize="12"
                           Visibility="{Binding IsBatchMode, Converter={StaticResource BoolToVis}}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ProgressBar IsIndeterminate="True" Width="100" Height="4"
                                 Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}"/>
                    <ProgressBar IsIndeterminate="True" Width="100" Height="4"
                                 Visibility="{Binding BatchVM.IsRunning, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════ IMAGE PREVIEW OVERLAY ═════════════════ -->
        <Grid x:Name="PreviewOverlay"
              Visibility="Collapsed"
              Grid.RowSpan="2"
              Background="#D4000000"
              Cursor="Hand"
              MouseLeftButtonUp="PreviewOverlay_Click"
              Panel.ZIndex="99">
            <Image x:Name="PreviewImage" Stretch="Uniform" Margin="50"/>
            <TextBlock Text="点击任意处关闭" Foreground="#80FFFFFF" FontSize="11"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"/>
        </Grid>

    </Grid>
</Window>
