  <ItemGroup>
    <ProjectReference Include="..\Chameleon.Core\Chameleon.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Chameleon.App.Tests" />
  </ItemGroup>

</Project>
