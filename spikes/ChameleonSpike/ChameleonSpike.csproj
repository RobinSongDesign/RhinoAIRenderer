<Project Sdk="Microsoft.NET.Sdk">

  <!-- Throw-away plug-in for phase 0: verifies platform assumptions inside a real Rhino. Not part of Chameleon.sln. -->
  <PropertyGroup>
    <TargetFrameworks>net7.0;net48</TargetFrameworks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TargetExt>.rhp</TargetExt>
    <AssemblyName>ChameleonSpike</AssemblyName>
    <RootNamespace>ChameleonSpike</RootNamespace>
    <Title>ChameleonSpike</Title>
    <Description>Chameleon phase 0 technical spike</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RhinoCommon" Version="8.19.25132.1001" ExcludeAssets="runtime" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="web\index.html" LogicalName="ChameleonSpike.web.index.html" />
  </ItemGroup>

</Project>
