<Window x:Class="AIRenderer.Views.BatchRenderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AIRenderer.Views"
        Title="Batch Render" Height="720" Width="1150"
        WindowStartupLocation="CenterOwner"
        Background="#F0F2F5">
    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="Margin" Value="0,8,0,3"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Padding" Value="0,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Left: Settings panel ────────────────────────────────────── -->
        <Border Grid.Column="0" Background="White" BorderBrush="#DDD" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14,16,16">
                <StackPanel>
                    <TextBlock Text="BATCH RENDER" FontSize="15" FontWeight="Bold" Foreground="#333" Margin="0,0,0,4"/>

                    <!-- Provider -->
                    <Border Background="#E8F4FD" BorderBrush="#B8D4E8" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,4">
                        <TextBlock FontSize="11" Foreground="#333">
                            <Run Text="Provider: "/>
                            <Run Text="{Binding ProviderDisplayName, Mode=OneWay}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </Border>

                    <Separator Margin="0,10,0,0"/>

                    <!-- Shared generation settings -->
                    <TextBlock Text="GENERATION SETTINGS" Style="{StaticResource SectionTitle}"/>

                    <TextBlock Text="Model" Style="{StaticResource Label}"/>
                    <ComboBox ItemsSource="{Binding Settings.ModelList}"
                              SelectedItem="{Binding Settings.SelectedModelItem}"
                              DisplayMemberPath="DisplayName"
                              Padding="8,5" FontSize="12"/>

                    <TextBlock Text="Style Template" Style="{StaticResource Label}"/>
                    <ComboBox ItemsSource="{Binding Settings.StyleTemplates}"
                              SelectedItem="{Binding Settings.SelectedStyle}"
                              DisplayMemberPath="Name"
                              Padding="8,5" FontSize="12"/>

                    <TextBlock Text="Prompt（所有视图共用）" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding Settings.Prompt, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" FontSize="12" BorderBrush="#CCC" BorderThickness="1"
                             TextWrapping="Wrap" AcceptsReturn="True" Height="70"
                             VerticalScrollBarVisibility="Auto"/>

                    <TextBlock Text="Aspect Ratio" Style="{StaticResource Label}"/>
                    <ComboBox ItemsSource="{Binding Settings.AspectRatios}"
                              SelectedItem="{Binding Settings.SelectedAspectRatio}"
                              DisplayMemberPath="Name" Padding="8,5" FontSize="12"/>

                    <TextBlock Text="Image Size" Style="{StaticResource Label}"/>
                    <ComboBox ItemsSource="{Binding Settings.ImageSizes}"
                              SelectedItem="{Binding Settings.SelectedImageSize}"
                              Padding="8,5" FontSize="12"/>

                    <Separator Margin="0,14,0,0"/>

                    <!-- Actions -->
                    <TextBlock Text="ACTIONS" Style="{StaticResource SectionTitle}"/>

                    <Button Content="加载命名视图" Command="{Binding LoadViewsCommand}"
                            Background="#4A90D9" Foreground="White" Style="{StaticResource Btn}"/>
                    <Separator Margin="0,10,0,0"/>

                    <Button Content="开始批量渲染" Command="{Binding RenderSelectedCommand}"
                            Background="#2E7D32" Foreground="White"
                            FontSize="13" FontWeight="SemiBold" Style="{StaticResource Btn}"/>
                    <Button Content="取消" Command="{Binding CancelCommand}"
                            Background="#E05555" Foreground="White" Style="{StaticResource Btn}"/>

                    <Separator Margin="0,10,0,0"/>

                    <Button Content="保存全部结果" Command="{Binding SaveAllCommand}"
                            Background="#757575" Foreground="White" Style="{StaticResource Btn}"/>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="全选" Command="{Binding SelectAllCommand}"
                                Background="#E0E0E0" Foreground="#333" Style="{StaticResource Btn}"/>
                        <Button Grid.Column="2" Content="取消全选" Command="{Binding DeselectAllCommand}"
                                Background="#E0E0E0" Foreground="#333" Style="{StaticResource Btn}"/>
                    </Grid>

                    <!-- Progress -->
                    <Separator Margin="0,14,0,0"/>
                    <ProgressBar IsIndeterminate="{Binding IsRunning}" Height="3" Margin="0,8,0,4"
                                 Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#555"
                               TextWrapping="Wrap"/>
                    <TextBlock FontSize="11" Foreground="#4A90D9" Margin="0,2,0,0"
                               Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                        <Run Text="{Binding DoneCount, Mode=OneWay}"/>
                        <Run Text=" / "/>
                        <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                        <Run Text=" 完成"/>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ── Right: Items list ───────────────────────────────────────── -->
        <Grid Grid.Column="1">
            <TextBlock Text="加载命名视图后，每行显示一个视图的源图和生成结果"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#BBB" FontSize="14"
                       Visibility="{Binding Items.Count, Converter={StaticResource InvBoolToVis}}"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Background="White"
                                    BorderBrush="#DDD" BorderThickness="1" CornerRadius="6">
                                <Grid Margin="12,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Checkbox -->
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                              VerticalAlignment="Center"/>

                                    <!-- View name -->
                                    <TextBlock Grid.Column="1" Text="{Binding ViewName}"
                                               FontWeight="SemiBold" FontSize="12"
                                               TextWrapping="Wrap" VerticalAlignment="Center"
                                               Margin="6,0"/>

                                    <!-- Source image -->
                                    <Border Grid.Column="2" Width="200" Height="130"
                                            Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1">
                                        <Grid>
                                            <TextBlock Text="未捕获" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" Foreground="#BBB" FontSize="12"
                                                       Visibility="{Binding HasSourceImage, Converter={StaticResource InvBoolToVis}}"/>
                                            <Image Source="{Binding SourceImage}" Stretch="Uniform" Margin="2"
                                                   Visibility="{Binding HasSourceImage, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </Border>

                                    <!-- Arrow -->
                                    <TextBlock Grid.Column="3" Text="→" FontSize="22" Foreground="#CCC"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <!-- Result image -->
                                    <Border Grid.Column="4" Width="200" Height="130"
                                            Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1">
                                        <Grid>
                                            <TextBlock Text="{Binding Status}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="#BBB" FontSize="12"
                                                       Visibility="{Binding HasResult, Converter={StaticResource InvBoolToVis}}"/>
                                            <Image Source="{Binding ResultImage}" Stretch="Uniform" Margin="2"
                                                   Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}"/>
                                            <!-- Generating overlay -->
                                            <Border Background="#CCFFFFFF"
                                                    Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ProgressBar IsIndeterminate="True" Width="80" Height="4"/>
                                                    <TextBlock Text="生成中..." HorizontalAlignment="Center"
                                                               Margin="0,5,0,0" FontSize="11" Foreground="#555"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Per-item controls -->
                                    <StackPanel Grid.Column="5" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#777" Margin="0,0,0,8"/>
                                        <Button Content="捕获" Tag="{Binding}"
                                                Click="CaptureOneButton_Click"
                                                Background="#6AAF6A" Foreground="White"
                                                Padding="8,5" FontSize="11" BorderThickness="0"
                                                Cursor="Hand" Margin="0,0,0,4">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.8"/></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Content="保存" Tag="{Binding}"
                                                Click="SaveOneButton_Click"
                                                IsEnabled="{Binding HasResult}"
                                                Background="#4A90D9" Foreground="White"
                                                Padding="8,5" FontSize="11" BorderThickness="0"
                                                Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.8"/></Trigger>
                                                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
